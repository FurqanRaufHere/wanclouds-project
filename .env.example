# Copy to .env and fill in. .env is gitignored — never commit real secrets.

# MySQL — must match the credentials in docker-compose.yml.
# Use host "mysql" (the compose service name), not localhost, from containers.
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=appuser
MYSQL_PASSWORD=apppassword
MYSQL_DB=appdb

# Redis — Celery broker and result backend.
REDIS_URL=redis://redis:6379/0

# JWT signing key. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# Back4App credentials for the car data source.
# From your Back4App dashboard: App Settings > Security & Keys.
BACK4APP_APP_ID=
BACK4APP_MASTER_KEY=
